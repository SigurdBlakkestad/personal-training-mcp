# Copy this file to .env and fill in your values.
# Never commit .env — it's in .gitignore.
# For GitHub Actions, add each value as a repository secret in Settings → Secrets and variables → Actions.

# === Core ===
# Supabase Postgres connection string. Use postgresql+psycopg:// prefix for SQLAlchemy.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# === Athlete profile (used by derived metrics) ===
# Your current FTP in watts. Update as you retest. Default 200 during rebuild.
ATHLETE_FTP=200

# === Strava (added in BUILD_PLAN Step 5) ===
# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Generated by one-time OAuth flow — see SETUP_MANUAL.md Section 4.2
STRAVA_REFRESH_TOKEN=

# === Withings (added in BUILD_PLAN Steps 6-7) ===
# From https://developer.withings.com
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
# Generated by scripts/withings_auth.py — see SETUP_MANUAL.md Section 5.3
WITHINGS_ACCESS_TOKEN=
WITHINGS_REFRESH_TOKEN=
WITHINGS_USERID=

# === Notion (added in BUILD_PLAN Step 10) ===
# Integration token from https://www.notion.so/profile/integrations
NOTION_TOKEN=
# Database IDs — see SETUP_MANUAL.md Section 6.4 for how to find them
NOTION_DB_ACTIVITIES_ID=
NOTION_DB_PLAN_ID=
NOTION_DB_METRICS_ID=

# === Weather (Open-Meteo, no auth) ===
# Default coordinates are Oslo. Override to your training location.
WEATHER_LATITUDE=59.9139
WEATHER_LONGITUDE=10.7522
WEATHER_TIMEZONE=Europe/Oslo

# === Garmin (added in BUILD_PLAN Step 12) ===
# Generated by scripts/garmin_auth.py — see SETUP_MANUAL.md Section 9.2
# This is a base64-encoded tarball of ~/.garminconnect tokens.
GARMINTOKENS_B64=

# Only needed if you want to re-bootstrap auth interactively (not used in CI)
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
